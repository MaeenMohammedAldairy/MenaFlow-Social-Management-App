{
  "expo": {
    "name": "MenaFlow",
    "slug": "menaflow-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "menaflow-mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F2FBFA",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.menaflow.mobile"
    },
    "android": {
      "package": "com.menaflow.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F2FBFA"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
