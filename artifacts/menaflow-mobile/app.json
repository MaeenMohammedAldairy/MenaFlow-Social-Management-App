{
  "expo": {
    "name": "MenaFlow",
    "slug": "menaflow-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "menaflow-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.menaflow.mobile",
      "infoPlist": {
        "CFBundleLocalizations": ["ar"]
      }
    },
    "android": {
      "package": "com.menaflow.mobile",
      "supportsRTL": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F5F7F6"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "lang": "ar",
      "dir": "rtl"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7F6",
          "image": "./assets/images/icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/with-preview-api-network-security"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f0601c41-264f-4f33-82c6-cfa334fa84f4"
      }
    },
    "owner": "maeenmohammed"
  }
}
