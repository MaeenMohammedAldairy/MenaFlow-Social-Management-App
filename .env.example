# ==========================================
# MenaFlow - Environment Configuration
# ==========================================

# Local-development template. Production uses the same variable names with
# platform-managed secrets and public HTTPS origins; do not copy local values.
# 1. Database Configuration
# Supabase PostgreSQL connection string (required; local database hosts are rejected).
# lib/db accepts *.supabase.co and *.pooler.supabase.com and nothing else.
# Prefer the SESSION pooler (port 5432) for a long-running Node API on an IPv4 host:
# the app keeps a persistent pg pool, which the transaction pooler (port 6543) breaks.
# Use the direct connection only when the API host has IPv6 egress.
# See docs/SUPABASE_DATABASE_SETUP.md §1.3. Keep sslmode=require; TLS is mandatory.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Supabase Storage for WhatsApp media (docs/SUPABASE_DATABASE_SETUP.md §6).
# Required by the API server but absent from this template until now: without them
# media upload falls back to the local filesystem and Meta publishing cannot resolve
# signed media URLs. The service-role key is server-only — never an EXPO_PUBLIC_ value.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=whatsapp-media

# 2. Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated exact browser origins allowed to call the API in production.
MENA_CORS_ORIGINS=
# Set to "true" only to enable automatic WhatsApp content creation; manual conversion remains available by default.
WHATSAPP_MARKETING_WORKER_ENABLED=false
# Automatic replies allowed per chat in a rolling hour (default 12, max 100).
# Protects the AI quota from two automated systems answering each other in a loop.
WHATSAPP_AUTO_REPLY_HOURLY_LIMIT=12
META_AUTO_REPLY_HOURLY_LIMIT=12
# Minutes a WhatsApp customer message stays eligible for an automatic reply (default 720 = 12h, max 10080).
WHATSAPP_AUTO_REPLY_MAX_AGE_MINUTES=720

# Owner console (internal read-only dashboard served at /owner). Disabled when both are empty.
# Static console key of at least 24 characters; comma-separate several to rotate. See docs/OWNER_CONSOLE.md.
MENA_OWNER_CONSOLE_TOKEN=
# Clerk user IDs allowed to open the console with their own session (comma-separated).
MENA_OWNER_USER_IDS=

# 3. Authentication & Access Control
# Set MENA_AUTH_DISABLED to "true" to run in local offline/development mode without Clerk
MENA_AUTH_DISABLED=true
MENA_OWNER_EMAIL=owner@example.com

# Clerk Authentication (Required when MENA_AUTH_DISABLED=false)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# 4. Token Encryption Key
# 32+ character random string used to encrypt Meta access tokens in the database
ENCRYPTION_KEY=your-secure-32-char-random-key-here-123456
# Optional secret-manager value during key rotation only; remove after old tokens are rotated.
ENCRYPTION_KEY_PREVIOUS=

# 5. Social Media Integration (Meta / Facebook & Instagram)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
META_GRAPH_VERSION=v26.0
MENA_FACEBOOK_REDIRECT_URI=http://localhost:5000/api/social/meta/callback
# Comma-separated exact web app origins when using temporary tunnels (no paths or trailing slash).
MENA_FACEBOOK_WEB_ORIGINS=

# 6. WhatsApp / Evolution API v2.3.7
# The API server creates a dedicated instance per owner at runtime for multi-tenant isolation.
# Do not set a single shared instance or config id here.
WHATSAPP_EVOLUTION_BASE_URL=http://localhost:8082
WHATSAPP_EVOLUTION_API_KEY=replace-with-a-random-evolution-api-key
# Required to authenticate Evolution callbacks to the content processor.
# Must be a dedicated random value, DIFFERENT from WHATSAPP_EVOLUTION_API_KEY:
# it is stored in the provider's webhook configuration, so reusing the admin key
# would turn a webhook leak into full control over every WhatsApp instance.
# Production refuses to start without it once Evolution is enabled; only
# development falls back to WHATSAPP_EVOLUTION_API_KEY.
WHATSAPP_EVOLUTION_WEBHOOK_SECRET=replace-with-a-random-secret
# Public callback URL required in production; development can use a public API domain or local Docker defaults.
WHATSAPP_EVOLUTION_WEBHOOK_URL=
WHATSAPP_ALBUM_SETTLE_MS=5000
# Delay standalone text briefly so a source-linked album can arrive before content is finalized.
WHATSAPP_TEXT_SETTLE_MS=5000
# Fallback only joins a unique, adjacent same-sender text and explicit album container; set 0 to disable.
WHATSAPP_TEXT_ALBUM_ASSOCIATION_MS=30000
# Public HTTPS API origin required for Instagram to fetch WhatsApp image/video media.
# Production requires this explicitly; the Expo app domain is a development-only fallback.
# For local development, run `pnpm dev:instagram` with cloudflared installed.
# The command supplies the temporary tunnel URL; localhost cannot be fetched by Meta.
MENA_PUBLIC_MEDIA_BASE_URL=

# 7. AI Providers (Arabic Content Generation)
# Gemini API Key (Recommended)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# 8. Push Notifications (Expo Push Service)
# Access token from expo.dev → project settings → access tokens. Required for
# delivery: without it the push worker stays off AND no alerts are queued at all,
# so nothing accumulates in the outbox while the feature is unconfigured.
# Create the token with the "Send push notifications" scope only.
EXPO_PUSH_ACCESS_TOKEN=
# Delivery attempts before an alert is abandoned (default 5).
PUSH_NOTIFICATION_MAX_ATTEMPTS=5
# Days a delivered or failed alert is kept before being purged (default 14).
# The dedupe key is time-bucketed, so purging is what keeps an old bucket from
# suppressing a legitimate new alert.
PUSH_NOTIFICATION_RETENTION_DAYS=14
# Set to "false" to stop the delivery and retention workers without removing the token.
PUSH_NOTIFICATION_WORKER_ENABLED=true
# Publishes posts whose scheduled_at instant has passed (default enabled).
# Set to "false" to pause due-time publishing without touching the data.
SCHEDULED_POSTS_WORKER_ENABLED=true
# Erases workspaces whose deletion request passed the 30-day grace period
# (default enabled). Set to "false" to freeze erasure (e.g. during an incident).
WORKSPACE_DELETION_WORKER_ENABLED=true

# ==========================================
# Mobile App Variables (Expo)
# ==========================================
EXPO_PUBLIC_DOMAIN=localhost:5000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
EXPO_PUBLIC_AUTH_DISABLED=true
