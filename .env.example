# ==========================================
# MenaFlow - Environment Configuration
# ==========================================

# Local-development template. Production uses the same variable names with
# platform-managed secrets and public HTTPS origins; do not copy local values.
# 1. Database Configuration
# Supabase PostgreSQL connection string (required; local database hosts are rejected)
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# 2. Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated exact browser origins allowed to call the API in production.
MENA_CORS_ORIGINS=
# Set to "true" only to enable automatic WhatsApp content creation; manual conversion remains available by default.
WHATSAPP_MARKETING_WORKER_ENABLED=false

# 3. Authentication & Access Control
# Set MENA_AUTH_DISABLED to "true" to run in local offline/development mode without Clerk
MENA_AUTH_DISABLED=true
MENA_OWNER_EMAIL=owner@example.com

# Clerk Authentication (Required when MENA_AUTH_DISABLED=false)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# 4. Token Encryption Key
# 32+ character random string used to encrypt Meta access tokens in the database
ENCRYPTION_KEY=your-secure-32-char-random-key-here-123456
# Optional secret-manager value during key rotation only; remove after old tokens are rotated.
ENCRYPTION_KEY_PREVIOUS=

# 5. Social Media Integration (Meta / Facebook & Instagram)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
META_GRAPH_VERSION=v26.0
MENA_FACEBOOK_REDIRECT_URI=http://localhost:5000/api/social/meta/callback
# Comma-separated exact web app origins when using temporary tunnels (no paths or trailing slash).
MENA_FACEBOOK_WEB_ORIGINS=

# 6. WhatsApp / Evolution API v2.3.7
# The API server creates a dedicated instance per owner at runtime for multi-tenant isolation.
# Do not set a single shared instance or config id here.
WHATSAPP_EVOLUTION_BASE_URL=http://localhost:8082
WHATSAPP_EVOLUTION_API_KEY=replace-with-a-random-evolution-api-key
# Required to authenticate Evolution callbacks to the content processor.
WHATSAPP_EVOLUTION_WEBHOOK_SECRET=replace-with-a-random-secret
# Public callback URL required in production; development can use Replit or local Docker defaults.
WHATSAPP_EVOLUTION_WEBHOOK_URL=
WHATSAPP_ALBUM_SETTLE_MS=5000
# Delay standalone text briefly so a source-linked album can arrive before content is finalized.
WHATSAPP_TEXT_SETTLE_MS=5000
# Fallback only joins a unique, adjacent same-sender text and explicit album container; set 0 to disable.
WHATSAPP_TEXT_ALBUM_ASSOCIATION_MS=30000
# Public HTTPS API origin required for Instagram to fetch WhatsApp image/video media.
# Production requires this explicitly; Replit/Expo-domain fallbacks are development-only.
# For local development, run `pnpm dev:instagram` with cloudflared installed.
# The command supplies the temporary tunnel URL; localhost cannot be fetched by Meta.
MENA_PUBLIC_MEDIA_BASE_URL=

# 7. AI Providers (Arabic Content Generation)
# Gemini API Key (Recommended)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Optional)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# Mobile App Variables (Expo)
# ==========================================
EXPO_PUBLIC_DOMAIN=localhost:5000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
EXPO_PUBLIC_AUTH_DISABLED=true
