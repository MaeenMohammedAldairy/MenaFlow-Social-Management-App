{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const { unlinkSync } = require('node:fs'); const userAgent = process.env.npm_config_user_agent || ''; if (!userAgent.startsWith('pnpm/')) { console.error('Use pnpm instead'); process.exit(1); } for (const file of ['package-lock.json', 'yarn.lock']) { try { unlinkSync(file); } catch (error) { if (error.code !== 'ENOENT') throw error; } }\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "test": "node --experimental-strip-types --test artifacts/api-server/src/lib/owner-access.test.mjs lib/api-client-react/src/custom-fetch.test.mjs artifacts/api-server/src/lib/whatsapp-groups.test.mjs artifacts/api-server/src/lib/whatsapp-content-associations.test.mjs artifacts/api-server/src/lib/whatsapp-pairing.test.mjs artifacts/api-server/src/lib/whatsapp-instance.test.mjs artifacts/api-server/src/lib/whatsapp-marketing-safety.test.mjs artifacts/api-server/src/lib/whatsapp-marketing-ai.test.mjs artifacts/api-server/src/lib/meta-graph-config.test.mjs artifacts/api-server/src/lib/meta-web-origin.test.mjs artifacts/api-server/src/lib/meta-pages.test.mjs artifacts/api-server/src/lib/publish-retry.test.mjs artifacts/api-server/src/lib/meta-channel-routing.test.mjs artifacts/api-server/src/lib/meta-media-url.test.mjs artifacts/api-server/src/lib/meta-publishing-media.test.mjs artifacts/api-server/src/lib/meta-oauth.test.mjs artifacts/api-server/src/lib/post-events.test.mjs artifacts/api-server/src/lib/whatsapp-evolution.test.mjs artifacts/api-server/src/lib/whatsapp-history.test.mjs artifacts/api-server/src/lib/whatsapp-sync-options.test.mjs artifacts/api-server/src/lib/meta-token-crypto.test.mjs artifacts/api-server/src/lib/facebook-performance.test.mjs artifacts/api-server/src/lib/workspace-context.test.mjs artifacts/api-server/src/lib/workspace-tenant-access.test.mjs artifacts/api-server/src/lib/whatsapp-opt-out.test.mjs artifacts/menaflow-mobile/lib/source-message-groups.test.mjs",
    "test:post-readiness": "node --experimental-strip-types --test artifacts/api-server/src/lib/post-readiness.test.mjs",
    "test:whatsapp-auto-reply": "node --experimental-strip-types --test artifacts/api-server/src/lib/whatsapp-auto-reply.test.mjs",
    "test:meta-auto-reply": "node --experimental-strip-types --test artifacts/api-server/src/lib/meta-auto-reply.test.mjs artifacts/api-server/src/lib/meta-inbox-graph.test.mjs",
    "db:migrate:whatsapp-albums": "node scripts/migrate-whatsapp-albums.js",
    "db:report:whatsapp-albums": "node scripts/report-whatsapp-album-post-candidates.js",
    "db:preview:whatsapp-media-recovery": "node scripts/preview-whatsapp-media-recovery.js",
    "db:migrate:workspaces": "node scripts/migrate-workspaces.mjs",
    "dev:instagram": "node scripts/dev-instagram-tunnel.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
