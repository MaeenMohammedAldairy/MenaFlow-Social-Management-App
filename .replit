modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
FACEBOOK_APP_ID = "1399522178499844"
WHATSAPP_EVOLUTION_BASE_URL = "http://localhost:8081"
WHATSAPP_EVOLUTION_INSTANCE = "Maeensoftware"
